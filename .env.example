# GearUp Backend Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials!

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_USERNAME=automobile_admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# ============================================
# Spring Configuration (Optional)
# ============================================
# These will override the defaults in application.yml
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/as_user_auth_service
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# ============================================
# Firebase Configuration
# ============================================
# Path to Firebase service account JSON file
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=C:/SecureKeys/gear-up/firebase-service-account.json

# ============================================
# Server Configuration (Optional)
# ============================================
# SERVER_PORT=8082

# ============================================
# Redis Configuration (Optional)
# ============================================
# SPRING_REDIS_HOST=localhost
# SPRING_REDIS_PORT=6379

# ============================================
# pgAdmin Configuration (Docker Compose)
# ============================================
PGADMIN_EMAIL=admin@gearup.com
PGADMIN_PASSWORD=your_pgadmin_password_here

# ============================================
# Usage Instructions:
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual passwords
# 3. For PowerShell scripts:
#    Set environment variables before running:
#    $env:POSTGRES_PASSWORD='your_password'
#    .\scripts\check-all-services.ps1
#
# 4. For Spring Boot application:
#    The application.yml will read these variables automatically
#    Or run with: mvnw spring-boot:run -Dspring-boot.run.arguments="--spring.datasource.password=your_password"

# ========================================
# SERVICE-SPECIFIC DATABASE CONFIGURATION
# ========================================

# Automobile Service
AUTOMOBILE_DB_URL=jdbc:postgresql://db:5432/as_automobile_service
AUTOMOBILE_DB_USER=svc_automobile_service
AUTOMOBILE_DB_PASSWORD=auto_svc_pass_2024

# Notification Service
NOTIFICATION_DB_URL=jdbc:postgresql://db:5432/as_notification_service
NOTIFICATION_DB_USER=svc_notification_service
NOTIFICATION_DB_PASSWORD=notif_svc_pass_2024

# User Auth Service
USER_AUTH_DB_URL=jdbc:postgresql://db:5432/as_user_auth_service
USER_AUTH_DB_USER=svc_user_auth_service
USER_AUTH_DB_PASSWORD=auth_svc_pass_2024

# Template Service
TEMPLATE_DB_URL=jdbc:postgresql://db:5432/as_template_service
TEMPLATE_DB_USER=svc_template_service
TEMPLATE_DB_PASSWORD=template_svc_pass_2024

# Payment Service
PAYMENT_DB_URL=jdbc:postgresql://db:5432/as_payment_service
PAYMENT_DB_USER=svc_payment_service
PAYMENT_DB_PASSWORD=payment_svc_pass_2024
