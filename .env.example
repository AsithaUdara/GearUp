# ==========================================
# Local Development Environment Configuration
# ==========================================
# This file contains environment variables for local development outside of Docker.
# For Docker deployment, see deployment/docker/.env

# ==========================================
# Firebase Configuration (Local Development)
# ==========================================
# Firebase credentials for local development
# On the host, set FIREBASE_CREDENTIALS_HOST_PATH to the absolute path of your Firebase JSON file
# Example (Windows): C:\SecureKeys\gear-up\firebase-service-account.json
# Example (Linux/macOS): /run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_HOST_PATH=

# This will be used by local Spring Boot applications
# Example: file:C:\SecureKeys\gear-up\firebase-service-account.json
APP_FIREBASE_CONFIGURATION_FILE=

# ==========================================
# Local Database Configuration (Optional)
# ==========================================
# Use these if running services locally (not in Docker)
# Override with your local PostgreSQL instance if needed
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gearup_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ==========================================
# Local RabbitMQ Configuration (Optional)
# ==========================================
# Use these if running services locally (not in Docker)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# ==========================================
# Local Redis Configuration (Optional)
# ==========================================
# Use these if running services locally (not in Docker)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# ==========================================
# IDE Configuration
# ==========================================
# Add any IDE-specific or local development variables here

