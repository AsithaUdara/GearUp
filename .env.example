# Database (local development defaults)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Per-service DB credentials (set these for each service you run locally)
# Example: AUTOMOBILE_DB_URL=jdbc:postgresql://db:5432/as_automobile_service
# AUTOMOBILE_DB_USER=auto_user
# AUTOMOBILE_DB_PASSWORD=auto_secure_pass_123

# For notification service defaults (override as needed per service)
NOTIFICATION_DB_URL=jdbc:postgresql://db:5432/as_notification_service
NOTIFICATION_DB_USER=svc_notification_service

# Notification service defaults (override as needed per service)
NOTIFICATION_DB_URL=jdbc:postgresql://db:5432/as_notification_service
NOTIFICATION_DB_USER=svc_notification_service

# Datasource fallbacks (can be used by a single-service run)
SPRING_DATASOURCE_URL=${NOTIFICATION_DB_URL}
SPRING_DATASOURCE_USERNAME=${NOTIFICATION_DB_USER}
SPRING_DATASOURCE_PASSWORD=${NOTIFICATION_DB_PASSWORD:-postgres}

# RabbitMQ
# Broker port (the port the application connects to) - default 5672
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
# Management UI port (use 15672 to open the web UI in a browser)
SPRING_RABBITMQ_MANAGEMENT_PORT=15672
SPRING_RABBITMQ_USERNAME=
SPRING_RABBITMQ_PASSWORD=

# Redis
SPRING_REDIS_HOST=
SPRING_REDIS_PORT=

# Firebase
# Firebase credentials mounting
# On the host, set FIREBASE_CREDENTIALS_HOST_PATH to the absolute path of your Firebase JSON file
# Example (Windows): C:\SecureKeys\gear-up\firebase-service-account.json
# Example (Linux/macOS): /run/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_HOST_PATH=

# Path inside the container where the credential file will be mounted (default below)
FIREBASE_CREDENTIALS_CONTAINER_PATH=/run/secrets/firebase-service-account.json

# The services will set APP_FIREBASE_CONFIGURATION_FILE=file:${FIREBASE_CREDENTIALS_CONTAINER_PATH}
