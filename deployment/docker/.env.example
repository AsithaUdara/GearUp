# ==========================================
# Docker Environment Configuration (Example)
# ==========================================
# This file is a template for deployment/docker/.env
# Copy this file to .env and update the values as needed:
#   Copy-Item .env.example .env

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ==========================================
# Service-Specific Database Credentials
# ==========================================
# Automobile Service
AUTOMOBILE_DB_URL=jdbc:postgresql://db:5432/as_automobile_service
AUTOMOBILE_DB_USER=svc_automobile_service
AUTOMOBILE_DB_PASSWORD=postgres

# Notification Service
NOTIFICATION_DB_URL=jdbc:postgresql://db:5432/as_notification_service
NOTIFICATION_DB_USER=svc_notification_service
NOTIFICATION_DB_PASSWORD=postgres

# User Auth Service
USER_AUTH_DB_URL=jdbc:postgresql://db:5432/as_user_auth_service
USER_AUTH_DB_USER=svc_user_auth_service
USER_AUTH_DB_PASSWORD=postgres

# Template Service
TEMPLATE_DB_URL=jdbc:postgresql://db:5432/as_template_service
TEMPLATE_DB_USER=svc_template_service
TEMPLATE_DB_PASSWORD=postgres

# Chatbot Service
CHATBOT_DB_URL=jdbc:postgresql://db:5432/as_chatbot_service
CHATBOT_DB_USER=svc_chatbot_service
CHATBOT_DB_PASSWORD=postgres
CHATBOT_DB_HOST=db
CHATBOT_DB_PORT=5432

# ==========================================
# Spring Datasource Defaults
# ==========================================
# These are used as fallback values
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ==========================================
# RabbitMQ Configuration
# ==========================================
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_MANAGEMENT_PORT=15672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# ==========================================
# Redis Configuration
# ==========================================
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379

# ==========================================
# Firebase Configuration (Container)
# ==========================================
# Path inside the container where Firebase credentials are mounted
FIREBASE_CREDENTIALS_CONTAINER_PATH=/run/secrets/firebase-service-account.json
APP_FIREBASE_CONFIGURATION_FILE=file:/run/secrets/firebase-service-account.json

# ==========================================
# Ollama Configuration
# ==========================================
OLLAMA_BASE_URL=http://ollama:11434

# ==========================================
# Additional Service Configuration
# ==========================================
# JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Eureka (if using service discovery)
EUREKA_URL=http://service-discovery:8761/eureka
