# ==========================================
# Docker Environment Configuration (Example)
# ==========================================
# This file is a template for deployment/docker/.env
# Copy this file to .env and update the values as needed:
#   Copy-Item .env.example .env

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
SPRING_DATASOURCE_DB=gearup
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/gearup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password

# ==========================================
# Service-Specific Database Credentials
# ==========================================
# All services connect to the same Postgres instance but different databases
# The init script will create these users and databases

# Notification Service
NOTIFICATION_DB_URL=jdbc:postgresql://db:5432/as_notification_service
NOTIFICATION_DB_USER=svc_notification_service
NOTIFICATION_DB_PASSWORD=change_me_notif_password

# User Auth Service
USER_AUTH_DB_URL=jdbc:postgresql://db:5432/as_user_auth_service
USER_AUTH_DB_USER=svc_user_auth_service
USER_AUTH_DB_PASSWORD=change_me_auth_password

# Chatbot Service
CHATBOT_DB_URL=jdbc:postgresql://db:5432/as_chatbot_service
CHATBOT_DB_USER=svc_chatbot_service
CHATBOT_DB_PASSWORD=change_me_chatbot_password

# Vehicle Service
VEHICLE_DB_URL=jdbc:postgresql://db:5432/as_vehicle_service
VEHICLE_DB_USER=svc_vehicle_service
VEHICLE_DB_PASSWORD=change_me_vehicle_password

# Customer Service
CUSTOMER_DB_URL=jdbc:postgresql://db:5432/as_customer_service
CUSTOMER_DB_USER=svc_customer_service
CUSTOMER_DB_PASSWORD=change_me_customer_password

# Tracking Service
TRACKING_DB_URL=jdbc:postgresql://db:5432/as_tracking_service
TRACKING_DB_USER=svc_tracking_service
TRACKING_DB_PASSWORD=change_me_tracking_password

# Analytical Service
ANALYTICAL_DB_URL=jdbc:postgresql://db:5432/as_analytical_service
ANALYTICAL_DB_USER=svc_analytical_service
ANALYTICAL_DB_PASSWORD=change_me_analytical_password

# Payment Service
PAYMENT_DB_URL=jdbc:postgresql://db:5432/as_payment_service
PAYMENT_DB_USER=svc_payment_service
PAYMENT_DB_PASSWORD=change_me_payment_password

# Parts Service
PARTS_DB_URL=jdbc:postgresql://db:5432/as_parts_service
PARTS_DB_USER=svc_parts_service
PARTS_DB_PASSWORD=change_me_parts_password

# Appointment Service
APPOINTMENT_DB_URL=jdbc:postgresql://db:5432/as_appointment_service
APPOINTMENT_DB_USER=svc_appointment_service
APPOINTMENT_DB_PASSWORD=change_me_appointment_password

# Modification Service
MODIFICATION_DB_URL=jdbc:postgresql://db:5432/as_modification_service
MODIFICATION_DB_USER=svc_modification_service
MODIFICATION_DB_PASSWORD=change_me_modification_password

# ==========================================
# RabbitMQ Configuration
# ==========================================
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_MANAGEMENT_PORT=15672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=change_me_rabbitmq_password
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change_me_rabbitmq_password

# ==========================================
# Redis Configuration
# ==========================================
# Consolidated Redis variables (use SPRING_DATA_REDIS_* for consistency)
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# ==========================================
# Eureka Service Discovery
# ==========================================
EUREKA_DEFAULT_ZONE=http://admin:password@service-discovery:8761/eureka/
EUREKA_URL=http://admin:password@service-discovery:8761/eureka
EUREKA_ADMIN_USER=admin
EUREKA_ADMIN_PASSWORD=change_me_eureka_password
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://admin:change_me_eureka_password@service-discovery:8761/eureka/

# ==========================================
# Config Server
# ==========================================
SPRING_CLOUD_CONFIG_URI=http://config-server:8888
CONFIG_SERVER_URI=http://config-server:8888
CONFIG_SERVER_PORT=8888
CONFIG_SERVER_USER=configadmin
CONFIG_SERVER_PASSWORD=change_me_config_password
CONFIG_REPO_URI=file:/app/config-repo

# ==========================================
# Firebase Configuration
# ==========================================
# Path inside the container where Firebase credentials are mounted
FIREBASE_CREDENTIALS_CONTAINER_PATH=/app/secrets/firebase-service-account.json
APP_FIREBASE_CONFIGURATION_FILE=/app/secrets/firebase-service-account.json
FIREBASE_CONFIG_PATH=/app/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=/app/secrets/firebase-service-account.json

# ==========================================
# Ollama Configuration (for Chatbot)
# ==========================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ==========================================
# SMTP Configuration (for Notification Service)
# ==========================================
SMTP_HOST=localhost
SMTP_PORT=25

# ==========================================
# WebSocket Configuration (for Chatbot)
# ==========================================
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# Additional Service Configuration
# ==========================================
# JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@gearup.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
